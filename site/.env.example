# Copy this file to .env (never committed) and set the real address.
# Read at build time only. The address is never written to the HTML in plain text:
# it is stored scrambled and the mailto link is assembled by a small script on click.
# If unset (or left at this example value), every email button simply links to the contact block of /work-with-us/.
SITE_CONTACT_EMAIL=someone@example.org

# Access code for the internal Product Build page (/product-build/). At least 12 characters; use a long one.
# Read at build time only and never written to the site. If unset, a release holds none of that page's data.
PRODUCT_BUILD_CODE=
