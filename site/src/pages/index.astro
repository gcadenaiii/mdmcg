---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import ChestDiagram from '../components/ChestDiagram.astro';
import FieldDiagram from '../components/FieldDiagram.astro';
import Marks from '../components/Marks.astro';
import Bars from '../components/Bars.astro';
import Stage from '../components/Stage.astro';
import WorkBand from '../components/WorkBand.astro';
import LabLink from '../components/LabLink.astro';
import HeroBeat from '../components/HeroBeat.astro';
import Chests42 from '../components/Chests42.astro';
import { HERO_BEAT, LAB, OPTIONS, TEAM } from '../config';
---
<Base title="mdmcg" description="A small sensor for the breastbone, designed to record the heart's magnetic signal alongside its ECG.">

<!-- ============ THE SPINE: six scenes, one stage. Why (scenes 1 and 2), then the design (scenes 3 to 6).
     The order of the scenes here must match SCENES in src/three/stage.js. ============ -->
<div class="wrap spine" id="spine">

  <section class="scene scene-hero" id="device" data-scene="Whole device" aria-labelledby="h-hero">
    <div class="scene-text">
      <p class="chip">Wearable heart sensor</p>
      <h1 id="h-hero" class="display">Your heart,<span class="teal">finally heard.</span></h1>
      <p class="lead">A small sensor for the breastbone, designed to record the heart's magnetic signal alongside its ECG.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/device/">See the design</a>
        <LabLink href={LAB.home}>Open the research tools</LabLink>
      </div>
    </div>
    <figure class="fig fig-hero" data-kind="render">
      <div class="fig-media">
        <div class="dimbox">
          <Pic name="device-hero" eager sizes="(max-width: 900px) 100vw, 60vw" alt="Option 1: a small white core with a teal ring and soft white wings that end in round electrode pads." />
          <svg class="dims" viewBox="0 0 830 523" aria-hidden="true" focusable="false">
            <g class="dim-line">
              <path d="M655 104 L574 326"/><path d="M645 100 L665 108"/><path d="M564 322 L584 330"/>
              <path d="M318 352 L512 398"/><path d="M320 342 L316 362"/><path d="M514 388 L510 408"/>
              <path d="M286 262 L286 316"/><path d="M277 262 L295 262"/><path d="M277 316 L295 316"/>
            </g>
            {HERO_BEAT && <HeroBeat />}
            <text x="672" y="208">60 mm</text>
            <text x="372" y="418">32 mm</text>
            <text x="216" y="295">9 mm</text>
          </svg>
        </div>
      </div>
    </figure>
  </section>

  <Stage />

  <!-- WHY -->
  <section class="scene" id="why" data-scene="Two signals" aria-labelledby="h-why">
    <div class="scene-text">
      <p class="chip">Why two signals</p>
      <h2 id="h-why" class="h2">Two signals<span class="teal">from one heartbeat.</span></h2>
      <p class="lead">Every heartbeat is an electric current. That current makes a voltage on the skin, the ECG, and a magnetic field outside the chest.</p>
      <p class="pull">An ECG does not determine the magnetic field. That is the reason to record both.</p>
      <p><a class="textlink" href="/science/">Read the science</a></p>
    </div>
    <figure class="fig" data-kind="shot">
      <div class="fig-media"><FieldDiagram kind="field" alt="The outline of a modelled chest with a grid of coloured squares over the heart: teal where the computed field points into the chest, a warm red where it points out of the chest. A dashed line marks the heart behind." /></div>
    </figure>
  </section>

  <!-- THE DESIGN -->
  <section class="scene" id="inside" data-scene="It opens" aria-labelledby="h-inside">
    <div class="scene-text">
      <p class="chip">The design</p>
      <h2 id="h-inside" class="h2">It opens to<span class="teal">six sensors.</span></h2>
      <p class="lead">The design is one piece, with the battery inside. Six magnetic sensors would sit in a small stiff core, and small is the point: it would sit closer to the chest.</p>
      <div class="stats">
        <div class="stat"><b>4.45<small>mm</small></b><span>largest gap under the small core, on scanned chests</span></div>
        <div class="stat stat-dim"><b>9.50<small>mm</small></b><span>under a bank-card-sized plate</span></div>
      </div>
      <p><a class="textlink" href="/device/">Inside the device</a></p>
    </div>
    <figure class="fig" data-kind="render" data-gl>
      <div class="fig-media"><Pic name="device-open" alt="Option 1 opened into layers: lid, flexible sheet with the wings, a flat coil, the sensor board with upright wire sensors, the shell and a soft pad." /></div>
    </figure>
  </section>

  <section class="scene" id="ecg" data-scene="Its own ECG" aria-labelledby="h-ecg">
    <div class="scene-text">
      <p class="chip">Its own ECG</p>
      <h2 id="h-ecg" class="h2">Two soft wings.<span class="teal">Two signals.</span></h2>
      <p class="lead">The wings are designed to carry ECG electrodes. The ECG would mark each beat, and the magnetic beats would be averaged on that mark.</p>
      <p>The magnetic signal of a single beat is too faint to read, so beats are added up. Needing fewer beats means a stronger reading, which is why this site counts in beats.</p>
    </div>
    <figure class="fig" data-kind="render" data-gl>
      <div class="fig-media"><Pic name="device-wing" class="fade-edges" alt="A soft white woven wing joining the white core beside its teal ring, with a round electrode pad at the end of the wing." /></div>
    </figure>
  </section>

  <section class="scene" id="worn" data-scene="On a chest" aria-labelledby="h-worn">
    <div class="scene-text">
      <p class="chip">Where it is worn</p>
      <h2 id="h-worn" class="h2">On the breastbone.<span class="teal">A zone, not a point.</span></h2>
      <p class="lead">Slide a finger down the middle of your chest until the bone stops. The design is centred just above that.</p>
      <div class="stats">
        <div class="stat"><b>3<small>cm</small></b><span>above where the bone stops</span></div>
        <div class="stat stat-dim"><b>1<small>cm</small></b><span>to the right would cost 1.4 times the beats</span></div>
      </div>
      <p>The place is a zone, not a point: forgiving toward the wearer's left, and a little up or down.</p>
      <p><a class="textlink" href="/reading/">How a reading would go</a></p>
    </div>
    <figure class="fig" data-kind="shot">
      <div class="fig-media"><ChestDiagram variant="zone" alt="The lower breastbone of a chest outlined from a scan, seen from the front: a mark where the bone stops, 3 cm up from it the core of the device on the midline, and a dashed outline of the zone it may sit in, which reaches toward the wearer's left." /></div>
    </figure>
  </section>

  <section class="scene" id="options" data-scene="Four proposals" aria-labelledby="h-options">
    <div class="scene-text">
      <p class="chip">Four proposals</p>
      <h2 id="h-options" class="h2">Four proposals.<span class="teal">One we recommend.</span></h2>
      <p class="lead">Each is a white shell with its own coloured ring. This site follows option 1.</p>
      <p><a class="textlink" href="/device/#options">Compare the four</a></p>
    </div>
    <figure class="fig" data-kind="render" data-gl>
      <div class="fig-media">
        <ul class="quad">
          {OPTIONS.map((o) => <li><Pic name={o.img} alt={o.alt} sizes="(max-width: 900px) 40vw, 300px" widths={[320, 480, 640]} /><span class:list={['ring', o.ring]}>{o.n}</span></li>)}
        </ul>
      </div>
    </figure>
  </section>

</div>

<!-- ============ THE EVIDENCE: the one dark band opens it ============ -->
<section class="band band-night" id="stands" aria-labelledby="h-stands">
  <div class="wrap">
    <p class="chip">The evidence</p>
    <div class="score" data-r>
      <div class="score-n"><h2 id="h-stands" class="numeral">42</h2><Chests42 /></div>
      <div class="score-side">
        <p class="score-line">real chests, scanned. One virtual trial of the design on every one of them.</p>
        <p class="lead">Each chest shape comes from a CT scan. In each one a computer model of the heart beats, the design is set on the skin, and we work out what its sensors would pick up. That is the virtual trial.</p>
      </div>
    </div>
    <div class="verdicts">
      <div class="verdict verdict-yes" data-r>
        <h3>Size</h3>
        <p>A small stiff core sits closer to the chest than a bank-card-sized one.</p>
      </div>
      <div class="verdict" data-r>
        <h3>Place</h3>
        <p>In the trial, the breastbone needs fewer beats than the shirt pocket or under the left breast.</p>
      </div>
      <div class="verdict" data-r>
        <h3>Fit</h3>
        <p>The wearing place is a zone, not a point, with 3 cm of freedom to the wearer's left.</p>
      </div>
    </div>
    <p class="vow" data-r>We'll make the claim when the evidence does.</p>
  </div>
</section>

<!-- ============ THE TOOLS: HEART TWIN ============ -->
<section class="band band-mist feature" id="heart-twin" aria-labelledby="h-ht">
  <div class="wrap feature-in">
    <div class="feature-art art-night" data-r>
      <Pic name="heart-only" sizes="(max-width: 900px) 92vw, 56vw" alt="The Heart Twin: a simulated heart coloured from deep blue, resting, to yellow, fired, half way through one beat." />
      <div class="float float-br">
        <p class="float-k">One heartbeat, three views</p>
        <ul><li>The heart</li><li>An ECG lead</li><li>A magnetic channel</li></ul>
      </div>
    </div>
    <div class="feature-text" data-r>
      <p class="chip">Heart Twin</p>
      <h2 id="h-ht" class="h2">A heart you can stop<span class="teal">and look inside.</span></h2>
      <p class="lead">The Heart Twin is a computer model: a simulated heart in a scanned chest. It shows one beat spreading, and the two signals it makes.</p>
      <div class="actions"><a class="btn btn-primary" href="/heart-twin/">How the Heart Twin works</a><LabLink href={LAB.watch}>Open the Heart Twin</LabLink></div>
    </div>
  </div>
</section>

<!-- ============ THE TOOLS: SENSOR STUDY ============ -->
<section class="band band-tint feature feature-flip" id="sensors" aria-labelledby="h-se">
  <div class="wrap feature-in">
    <div class="feature-text" data-r>
      <p class="chip">Sensor study</p>
      <h2 id="h-se" class="h2">Will it read<span class="teal">my heart?</span></h2>
      <p class="lead">Pick a body from the 42 scanned chests, a place to wear it and a device. The sensor tool shows how many beats a reading would need, as a range.</p>
      <p>The card here shows the recovery wave: the slower, smaller wave that follows the main spike of each beat.</p>
      <div class="actions"><a class="btn btn-primary" href="/sensors/">How the study works</a><LabLink href={LAB.explore}>Try the sensor tool</LabLink></div>
    </div>
    <div class="feature-art art-ask" data-r>
      <FieldDiagram kind="strength" compact class="ask-chest ask-map" alt="The outline of a modelled chest with a grid of squares coloured from white, weaker, to a warm red, stronger, showing where the computed heartbeat is strongest. A dashed line marks the heart behind." />
      <div class="ask-card">
        <p class="ask-q">The typical man, lower breastbone, option 1, recovery wave</p>
        <p class="ask-n"><span>about</span> 40 <span>beats</span></p>
        <Bars label="Beats needed by place worn: 39.9 at the breastbone rule, 99.5 at the left chest pocket, 106.9 under the left breast." rows={[{ label: 'Breastbone', value: 39.9 }, { label: 'Chest pocket', value: 99.5 }, { label: 'Under left breast', value: 106.9 }]} />
      </div>
    </div>
  </div>
</section>

<!-- ============ EVIDENCE ============ -->
<section class="band" id="evidence" aria-labelledby="h-ev">
  <div class="wrap know">
    <div class="know-head" data-r>
      <p class="chip">Evidence</p>
      <h2 id="h-ev" class="h2">The evidence,<span class="teal">set out in full.</span></h2>
      <p class="lead">The figures for size, place and fit come from one simulation study on 42 scanned chests. The evidence page sets it out, and the full research tools are open to try.</p>
      <div class="actions"><a class="btn btn-primary" href="/evidence/">Read the evidence</a></div>
    </div>
    <div class="know-cards">
      <div class="kcard" data-r>
        <p class="kcard-n">21<small>to</small>59</p>
        <Marks n={42} women={25} label="42 scanned chests: 25 women shown as circles, 17 men shown as squares." />
        <h3>Ages in the scanned set</h3>
        <p>25 women and 17 men. Real anatomy from CT scans, with one heart model in every chest.</p>
      </div>
      <div class="kcard kcard-open" data-r>
        <p class="kcard-n">89</p>
        <Marks n={89} open label="89 older chests, drawn as empty marks: the run is in progress." />
        <h3>Older chests, next</h3>
        <p>A second run on 89 older chests, aged 61 to 94, is under way.</p>
      </div>
      <div class="kcard kcard-wide" data-r>
        <div>
          <h3>What the study uses</h3>
          <ul><li>Real chest shapes from CT scans</li><li>The same heart model in every chest</li><li>The sensor resting on the skin</li></ul>
        </div>
        <div>
          <h3>What it compares</h3>
          <ul><li>Places to wear the device</li><li>Sensor layouts and sizes</li><li>One body against another</li></ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TEAM ============ -->
<section class="band band-mist" id="team" aria-labelledby="h-team">
  <div class="wrap">
    <header class="sec-head sec-head-row" data-r>
      <div>
        <p class="chip">Team</p>
        <h2 id="h-team" class="h2">The people behind<span class="teal">the design.</span></h2>
      </div>
      <a class="btn btn-ghost" href="/team/">Meet the team</a>
    </header>
    <ul class="crew">
      {TEAM.map((p) => (
        <li data-r>
          <a href="/team/" class="crew-card">
            <span class="crew-face"><Pic name={p.photo} alt="" sizes="112px" widths={[112, 224]} /></span>
            <span class="crew-id"><b>{p.name}</b><span>{p.role}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<WorkBand />
</Base>
