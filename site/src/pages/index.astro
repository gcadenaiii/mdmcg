---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import ChestDiagram from '../components/ChestDiagram.astro';
import FieldDiagram from '../components/FieldDiagram.astro';
import Marks from '../components/Marks.astro';
import Bars from '../components/Bars.astro';
import Stage from '../components/Stage.astro';
import WorkBand from '../components/WorkBand.astro';
import LabLink from '../components/LabLink.astro';
import HeroBeat from '../components/HeroBeat.astro';
import Chests42 from '../components/Chests42.astro';
import { HERO_BEAT, LAB, TEAM } from '../config';
import ProofBars from '../components/ProofBars.astro';
import BeatBuild from '../components/BeatBuild.astro';
---
<Base title="mdmcg" description="A small device for the breastbone that records the heart's magnetic signal alongside its ECG.">

<!-- ============ THE SPINE: six scenes, one stage. Why (scenes 1 and 2), the device (scenes 3 to 5), a reading (scene 6).
     The order of the scenes here must match SCENES in src/three/stage.js. ============ -->
<div class="wrap spine" id="spine">

  <section class="scene scene-hero" id="device" data-scene="Whole device" aria-labelledby="h-hero">
    <div class="scene-text">
      <p class="chip">Wearable heart sensor</p>
      <h1 id="h-hero" class="display">Your heart,<span class="teal">finally heard.</span></h1>
      <p class="lead">A small device for the breastbone. It records the heart's magnetic signal alongside its ECG, from the same beat.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/device/">See the device</a>
        <a class="btn btn-ghost" href="/reading/">How a reading goes</a>
      </div>
    </div>
    <figure class="fig fig-hero" data-kind="render">
      <div class="fig-media">
        <div class="dimbox">
          <Pic name="device-hero" eager sizes="(max-width: 900px) 100vw, 60vw" alt="The device: a small white core with a teal ring and soft white wings that end in round electrode pads." />
          <svg class="dims" viewBox="0 0 830 523" aria-hidden="true" focusable="false">
            <g class="dim-line">
              <path d="M655 104 L574 326"/><path d="M645 100 L665 108"/><path d="M564 322 L584 330"/>
              <path d="M318 352 L512 398"/><path d="M320 342 L316 362"/><path d="M514 388 L510 408"/>
              <path d="M286 262 L286 316"/><path d="M277 262 L295 262"/><path d="M277 316 L295 316"/>
            </g>
            {HERO_BEAT && <HeroBeat />}
            <text x="672" y="208">60 mm</text>
            <text x="372" y="418">32 mm</text>
            <text x="216" y="295">9 mm</text>
          </svg>
        </div>
      </div>
    </figure>
  </section>

  <Stage />

  <!-- WHY -->
  <section class="scene" id="why" data-scene="Two signals" aria-labelledby="h-why">
    <div class="scene-text">
      <p class="chip">Why two signals</p>
      <h2 id="h-why" class="h2">The ECG shows<span class="teal">half the picture.</span></h2>
      <p class="lead">A normal ECG does not always rule out heart disease. Every beat also makes a magnetic field outside the chest, and it shows the heart from a different side.</p>
      <p class="pull">That was a hospital test. mdmcg brings the same signal to your breastbone, in an ordinary room.</p>
      <p><a class="textlink" href="/science/#room">Read the science</a></p>
    </div>
    <figure class="fig" data-kind="shot">
      <div class="fig-media"><ProofBars /></div>
    </figure>
  </section>

  <!-- THE DESIGN -->
  <section class="scene" id="inside" data-scene="It opens" aria-labelledby="h-inside">
    <div class="scene-text">
      <p class="chip">Inside</p>
      <h2 id="h-inside" class="h2">It opens to<span class="teal">six sensors.</span></h2>
      <p class="lead">One piece, with the battery inside. Six magnetic sensors sit in a small stiff core. Small is the point: it sits closer to the chest.</p>
      <p><a class="textlink" href="/device/">Inside the device</a></p>
    </div>
    <figure class="fig" data-kind="render" data-gl>
      <div class="fig-media"><Pic name="device-open" alt="The device opened into layers: lid, flexible sheet with the wings, a flat coil, the sensor board with upright wire sensors, the shell and a soft pad." /></div>
    </figure>
  </section>

  <section class="scene" id="ecg" data-scene="Its own ECG" aria-labelledby="h-ecg">
    <div class="scene-text">
      <p class="chip">Its own ECG</p>
      <h2 id="h-ecg" class="h2">Two soft wings.<span class="teal">Two signals.</span></h2>
      <p class="lead">The wings carry the ECG electrodes. The ECG marks each beat.</p>
      <p><a class="textlink" href="/device/">See the device</a></p>
    </div>
    <figure class="fig" data-kind="render" data-gl>
      <div class="fig-media"><Pic name="device-wing" class="fade-edges" alt="A soft white woven wing joining the white core beside its teal ring, with a round electrode pad at the end of the wing." /></div>
    </figure>
  </section>

  <section class="scene" id="worn" data-scene="On a chest" aria-labelledby="h-worn">
    <div class="scene-text">
      <p class="chip">Where it is worn</p>
      <h2 id="h-worn" class="h2">On the breastbone.<span class="teal">A zone, not a point.</span></h2>
      <p class="lead">Slide a finger down the middle of your chest until the bone stops. It sits just above that.</p>
      <div class="stats">
        <div class="stat"><b>3<small>cm</small></b><span>above where the bone stops</span></div>
        <div class="stat stat-dim"><b>1<small>cm</small></b><span>to the right costs 1.4 times the beats in the virtual trial</span></div>
      </div>
      <p>The place is a zone, not a point: forgiving toward the wearer's left, and a little up or down. An elastic strap with a cradle presses the core to the skin.</p>
      <p><a class="textlink" href="/device/#wear">Ways to wear it</a></p>
    </div>
    <figure class="fig" data-kind="shot">
      <div class="fig-media"><ChestDiagram variant="zone" alt="The lower breastbone of a chest outlined from a scan, seen from the front: a mark where the bone stops, 3 cm up from it the core of the device on the midline, and a dashed outline of the zone it may sit in, which reaches toward the wearer's left." /></div>
    </figure>
  </section>

  <section class="scene" id="record" data-scene="A reading" aria-labelledby="h-record">
    <div class="scene-text">
      <p class="chip">A reading</p>
      <h2 id="h-record" class="h2">Sit still.<span class="teal">Forty beats. One record.</span></h2>
      <p class="lead">One beat is too faint to read. The ECG marks each beat, and the magnetic beats are lined up on that mark and added, until the signal is clear.</p>
      <p class="pull">Two signals from the same heartbeats, on one clock. A record for you and your doctor.</p>
      <p class="note">About 8 beats for the main spike, about 40 for the slower wave that follows, for a typical chest in the virtual trial.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact/">Ask the founders about it</a>
        <a class="textlink" href="/reading/">How a reading goes</a>
      </div>
    </div>
    <figure class="fig" data-kind="shot">
      <div class="fig-media"><BeatBuild /></div>
    </figure>
  </section>

</div>

<!-- ============ THE SCIENCE BEHIND IT: the one dark band opens it ============ -->
<section class="band band-night" id="stands" aria-labelledby="h-stands">
  <div class="wrap">
    <p class="chip">The science behind it</p>
    <div class="score" data-r>
      <div class="score-n"><h2 id="h-stands" class="numeral">42</h2><Chests42 /></div>
      <div class="score-side">
        <p class="score-line">real chests, scanned. One virtual trial of the device on every one of them.</p>
        <p class="lead">Each chest shape comes from a CT scan. In each one a computer model of the heart beats, the device rests on the skin, and we work out what its sensors pick up. That is the virtual trial.</p>
      </div>
    </div>
    <div class="verdicts">
      <div class="verdict verdict-yes" data-r>
        <h3>Size</h3>
        <p>A small stiff core sits closer to the chest than a bank-card-sized one.</p>
      </div>
      <div class="verdict" data-r>
        <h3>Place</h3>
        <p>In the trial, the breastbone needs fewer beats than the chest pocket or under the left breast.</p>
      </div>
      <div class="verdict" data-r>
        <h3>Fit</h3>
        <p>The wearing place is a zone, not a point, with 3 cm of freedom to the wearer's left.</p>
      </div>
    </div>
    <div class="actions" data-r><a class="btn btn-white" href="/evidence/">Read the evidence</a></div>
  </div>
</section>

<!-- ============ THE TOOLS: HEART TWIN ============ -->
<section class="band band-mist feature" id="heart-twin" aria-labelledby="h-ht">
  <div class="wrap feature-in">
    <div class="feature-art art-night" data-r>
      <Pic name="heart-only" sizes="(max-width: 900px) 92vw, 56vw" alt="The Heart Twin: a simulated heart coloured from deep blue, resting, to yellow, fired, half way through one beat." />
      <div class="float float-br">
        <p class="float-k">One heartbeat, three views</p>
        <ul><li>The heart</li><li>An ECG lead</li><li>A magnetic channel</li></ul>
      </div>
    </div>
    <div class="feature-text" data-r>
      <p class="chip">Heart Twin</p>
      <h2 id="h-ht" class="h2">A heart you can stop<span class="teal">and look inside.</span></h2>
      <p class="lead">The Heart Twin is a computer model: a simulated heart in a scanned chest. It shows one beat spreading, and the two signals it makes.</p>
      <div class="actions"><a class="btn btn-primary" href="/heart-twin/">How the Heart Twin works</a><LabLink href={LAB.watch}>Open the Heart Twin</LabLink></div>
    </div>
  </div>
</section>

<!-- ============ TEAM ============ -->
<section class="band band-mist" id="team" aria-labelledby="h-team">
  <div class="wrap">
    <header class="sec-head sec-head-row" data-r>
      <div>
        <p class="chip">Team</p>
        <h2 id="h-team" class="h2">The people<span class="teal">building it.</span></h2>
      </div>
      <a class="btn btn-ghost" href="/team/">Meet the team</a>
    </header>
    <ul class="crew">
      {TEAM.map((p) => (
        <li data-r>
          <a href="/team/" class="crew-card">
            <span class="crew-face"><Pic name={p.photo} alt="" sizes="112px" widths={[112, 224]} /></span>
            <span class="crew-id"><b>{p.name}</b><span>{p.role}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<WorkBand />
</Base>
