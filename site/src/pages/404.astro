---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist. The device, the science and the research tools are one step away.">
<section class="lost" aria-labelledby="h-page">
  <div class="wrap">
    <p class="numeral" aria-hidden="true">404</p>
    <div class="lost-text">
      <h1 id="h-page" class="h2">This page<span class="teal">skipped a beat.</span></h1>
      <p class="lead" style="margin-inline:auto">The address is not on this site. The device and the research are one step away.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn btn-ghost" href="/device/">See the device</a>
      </div>
    </div>
  </div>
</section>
</Base>
