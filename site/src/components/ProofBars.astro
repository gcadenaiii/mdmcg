---
// The published comparison behind "The ECG shows half the picture": two bars that fill when the scene comes into view. Both
// grow at the same pace; the grey one stops at 40.5 and the teal one runs on to 68.4, so the gap is what the eye is left with.
// Figures: Shin and colleagues, 2019 (doi 10.3233/CH-180485): 202 patients with suspected coronary artery disease,
// coronary angiography as the reference; share of the disease found by the magnetic test and by exercise ECG.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<div class:list={['proof', cls]}>
  <div class="proof-rows" role="img" aria-label="Two bars from one hospital study of 202 patients: the magnetic heart test found 68.4 percent of coronary disease, exercise ECG found 40.5 percent.">
    <p class="proof-k">Coronary disease found, same 202 patients</p>
    <div class="proof-row">
      <span class="proof-l">Magnetic heart test</span>
      <span class="proof-t"><span class="proof-f" style="--w:68.4%; --d:1690ms"></span></span>
      <span class="proof-v">68.4<small>%</small></span>
    </div>
    <div class="proof-row proof-dim">
      <span class="proof-l">Exercise ECG</span>
      <span class="proof-t"><span class="proof-f" style="--w:40.5%; --d:1000ms"></span></span>
      <span class="proof-v">40.5<small>%</small></span>
    </div>
  </div>
  <p class="proof-s">A hospital study. <a href="https://doi.org/10.3233/CH-180485" rel="noopener">Shin and colleagues, 2019</a></p>
</div>
