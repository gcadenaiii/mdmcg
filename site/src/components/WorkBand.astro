---
// The closing teal band, shared by every page.
import EmailButton from './EmailButton.astro';
interface Props { title?: string; }
const { title = 'Help us take it from simulation to the bench.' } = Astro.props;
---
<section class="band band-teal" aria-labelledby="h-work">
  <div class="wrap">
    <div class="close" data-r>
      <h2 id="h-work" class="h2 h2-xl">{title}</h2>
      <div class="close-cta">
        <EmailButton />
        <p>Opens your email program. Nothing is stored on this site.</p>
        <a class="onteal-link" href="/work-with-us/">Who we want to hear from</a>
      </div>
    </div>
  </div>
</section>
