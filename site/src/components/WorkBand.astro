---
// The closing teal band, shared by every page. It names who the ask is for.
import EmailButton from './EmailButton.astro';
import { HAS_CONTACT } from '../contact';
interface Props { title?: string; }
const { title = 'Two signals from one heartbeat.' } = Astro.props;
---
<section class="band band-teal" aria-labelledby="h-work">
  <div class="wrap">
    <div class="close" data-r>
      <div class="close-head">
        <h2 id="h-work" class="h2">{title}</h2>
        <p class="close-for">Questions about the device? The three founders read every email and answer it.</p>
      </div>
      <div class="close-cta">
        <EmailButton />
        {HAS_CONTACT && <p>Opens your email program. Nothing is stored on this site.</p>}
        <a class="onteal-link" href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</section>
