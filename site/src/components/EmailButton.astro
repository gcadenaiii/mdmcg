---
// "Email us" button. The address comes from SITE_CONTACT_EMAIL at build time and is never written to the page in plain text:
// it is stored scrambled in data-m and the mailto link is assembled on click (see scripts/site.js).
// If the variable is unset the button is an ordinary link to /work-with-us/.
interface Props { label?: string; class?: string; subject?: string; }
const { label = 'Email us', class: cls = 'btn btn-white', subject = 'mdmcg: working together' } = Astro.props;
const raw = (import.meta.env.SITE_CONTACT_EMAIL ?? process.env.SITE_CONTACT_EMAIL ?? '').trim();
const ok = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(raw) && !raw.endsWith('@example.org');
const scrambled = ok ? Array.from(raw).reverse().map((c) => (c.charCodeAt(0) + 7).toString(36)).join('.') : undefined;
---
<a class={cls} href="/work-with-us/" data-m={scrambled} data-s={ok ? subject : undefined}>{label}</a>
