---
import Pic from './Pic.astro';
import { OPTIONS } from '../config';
---
<ol class="opts">
  {OPTIONS.map((o) => (
    <li class:list={['opt', o.n === 2 && 'opt-on']} data-r>
      <div class="opt-art"><Pic name={o.img} alt={o.alt} sizes="(max-width: 560px) 90vw, (max-width: 1180px) 45vw, 22vw" widths={[320, 480, 640]} /><span class:list={['ring', o.ring]}>{o.n}</span></div>
      <p class="opt-flag">{o.flag}</p>
      <h3 class="opt-name">{o.name}</h3>
      <p class="opt-status">{o.line}</p>
      <p class="opt-spec">{o.size}, {o.sensors} sensors</p>
    </li>
  ))}
</ol>
<figure class="scale-row" data-r>
  <Pic name="options-row" sizes="(max-width: 900px) 100vw, 1280px" widths={[768, 1280, 1920, 2560]} alt="The four options side by side at the same scale: options 1, 2 and 4 share a 60 by 32 millimetre core at three thicknesses, and option 3 is a longer plate, 124 by 46 millimetres." />
  <figcaption class="note">The four options at the same scale.</figcaption>
</figure>
