---
// The first screen's heartbeat, drawn as coming out of the device. Two thin lines leave the hero picture, one from an ECG
// electrode pad and one from the core, and run out under the headline as the two signals of one computed beat on one clock.
// It lives inside the hero picture's own drawing (the .dims svg, 830 x 523 units), so it scales and fades with the picture.
// Shapes come from the research tool's export (src/data/traces.json), each scaled to its own peak; no units are drawn.
import data from '../data/traces.json';
const X0 = -520, X1 = -70, amp = 30;
const trace = (arr: number[], base: number) => arr.map((v, i) => `${i ? 'L' : 'M'}${(X0 + (i / (arr.length - 1)) * (X1 - X0)).toFixed(1)} ${(base - v * amp).toFixed(1)}`).join(' ');
const ECG_Y = 522, MCG_Y = 562;
---
<g class="herobeat" aria-hidden="true">
  <path class="hb-ecg" pathLength="1" d={`${trace(data.ecg, ECG_Y)} L 30 ${ECG_Y} Q 72 ${ECG_Y} 76 332`} />
  <path class="hb-mcg" pathLength="1" d={`${trace(data.mcg, MCG_Y)} L 240 ${MCG_Y} Q 298 ${MCG_Y} 302 344`} />
  <circle class="hb-ecg-dot" cx="76" cy="332" r="3.2" /><circle class="hb-mcg-dot" cx="302" cy="344" r="3.2" />
  <text class="hb-t" x="-58" y={ECG_Y - 9}>ECG</text>
  <text class="hb-t hb-k" x="-58" y={MCG_Y - 9}>Magnetic</text>
</g>
